# Google Cloud OAuth credentials (from Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Must exactly match an "Authorized redirect URI" configured on the OAuth client
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Public base URL of this app (used to build the redirect URI and links)
BASE_URL=http://localhost:3000

# Any random long string, used to sign session cookies
SESSION_SECRET=change-this-to-a-random-string

# Port to listen on
PORT=3000

# Optional: enables "AI-written reply" mode for categories where you turn it
# on. Get a key at https://console.anthropic.com/settings/keys — this uses
# your own account and incurs standard per-token API usage cost (small at
# personal-inbox volume, but not free like the keyword classifier).
# Leave blank to disable AI replies entirely (fixed templates still work).
ANTHROPIC_API_KEY=

# Optional: override the model used for AI replies.
ANTHROPIC_MODEL=claude-sonnet-5
